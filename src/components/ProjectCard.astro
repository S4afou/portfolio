---
import type { CollectionEntry } from 'astro:content';
import { publicationSummary } from '../lib/repos';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const { data } = project;
const shownStack = data.stack.slice(0, 4);
const hiddenStackCount = data.stack.length - shownStack.length;
---

<a
  href={`/projects/${project.id}`}
  class="group flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blood"
>
  <div class="aspect-[16/9] overflow-hidden bg-panel">
    <img
      src={data.cover.src}
      alt={data.cover.alt}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.02]"
    />
  </div>

  <div class="flex items-start justify-between gap-4 pt-4">
    {headingLevel === 2 ? <h2 class="h-sub">{data.title}</h2> : <h3 class="h-sub">{data.title}</h3>}
    <span
      class="mt-1 text-lg leading-none text-muted transition duration-200 group-hover:-translate-y-0.5 group-hover:text-blood"
      aria-hidden="true">↗</span
    >
  </div>

  <p class="mt-2 text-sm leading-relaxed text-muted">{data.summary}</p>

  <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-5 text-xs text-muted">
    <span>{publicationSummary(data.repos)}</span>
    <span aria-hidden="true" class="text-line">/</span>
    <span>
      {shownStack.join(' · ')}
      {hiddenStackCount > 0 && ` +${hiddenStackCount}`}
    </span>
  </div>
</a>
