---
import type { Achievement } from '../lib/achievements';

interface Props {
  items: Achievement[];
}

const { items } = Astro.props;
---

<ol class="flex flex-col">
  {
    items.map((item) => (
      <li class="grid gap-2 border-t border-line py-5 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-6">
        <span class="mono text-[11px] uppercase tracking-[0.12em] text-muted">{item.period}</span>
        <div>
          <h3 class="text-base font-semibold leading-snug">{item.title}</h3>
          <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-ember">{item.org}</p>
          <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-muted">{item.detail}</p>
        </div>
      </li>
    ))
  }
</ol>
