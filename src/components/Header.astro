---
import { NAV, SITE } from '../lib/site';
import Mark from './Mark.astro';
---

<header class="sticky top-0 z-50 border-b border-line bg-void/90 backdrop-blur-md">
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label={`${SITE.name} — home`}>
      <Mark size={24} class="shrink-0 text-paper" />
      <span class="hidden truncate text-[0.82rem] font-medium tracking-[-0.01em] text-paper/90 lg:inline">
        {SITE.name}
      </span>
    </a>

    <nav aria-label="Primary" class="flex shrink-0 items-center gap-3 sm:gap-5">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={
              Astro.url.pathname === item.href || Astro.url.pathname.startsWith(`${item.href}/`)
                ? 'page'
                : undefined
            }
            class="nav-link"
          >
            {item.label}
          </a>
        ))
      }
      <a href={SITE.cv} download class="btn btn-solid !px-2.5 !py-1.5 text-[0.72rem]">CV</a>
    </nav>
  </div>
</header>
