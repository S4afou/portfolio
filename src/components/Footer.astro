---
import { CONTACT_SUBJECTS, mailto } from '../lib/contact';
import { NAV, SITE } from '../lib/site';
import Mark from './Mark.astro';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line/80">
  <div class="shell grid gap-10 py-12 md:grid-cols-[1.4fr_0.8fr_1fr]">
    <div>
      <a href="/" class="flex w-fit items-center gap-3">
        <Mark size={26} class="text-paper" />
        <p class="text-[0.84rem] font-medium tracking-[-0.01em]">{SITE.name}</p>
      </a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
        {SITE.role} · {SITE.school}. {SITE.availability}.
      </p>
      <p class="mt-4 flex items-center gap-2 text-xs text-muted">
        <span class="pulse-dot" aria-hidden="true"></span>
        {SITE.location}
      </p>
    </div>

    <nav aria-label="Footer" class="flex flex-col gap-2">
      <p class="label mb-1">Index</p>
      {
        NAV.map((item) => (
          <a class="footer-link w-fit text-sm text-muted transition hover:text-paper" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a class="footer-link w-fit text-sm text-muted transition hover:text-paper" href={SITE.cv} download>Download CV</a>
    </nav>

    <div class="flex flex-col gap-2">
      <p class="label mb-1">Contact</p>
      <a
        class="footer-link w-fit break-all text-sm text-muted transition hover:text-paper"
        href={mailto(CONTACT_SUBJECTS.general)}
      >
        {SITE.email}
      </a>
      <a
        class="footer-link w-fit text-sm text-muted transition hover:text-paper"
        href={SITE.linkedin}
        target="_blank"
        rel="noopener noreferrer">LinkedIn</a
      >
      <a
        class="footer-link w-fit text-sm text-muted transition hover:text-paper"
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
    </div>
  </div>

  <div class="border-t border-line/70">
    <div class="shell flex flex-wrap items-center justify-between gap-3 py-5 text-xs text-muted">
      <p>© {year} · {SITE.location}</p>
      <a class="transition hover:text-paper" href="#main">Back to top ↑</a>
    </div>
  </div>
</footer>
