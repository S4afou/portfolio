---
import type { Repo } from '../lib/project-schema';
import { linkableRepos } from '../lib/repos';

interface Props {
  repos: Repo[];
}

const { repos } = Astro.props;
const links = linkableRepos(repos);
---

{
  links.length > 0 && (
    <ul class="flex flex-col gap-2">
      {links.map((repo) => (
        <li>
          <a
            class="btn btn-ghost w-fit !px-3 !py-1.5 text-[0.72rem]"
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>{repo.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
