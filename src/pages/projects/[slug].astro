---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageFigure from '../../components/ImageFigure.astro';
import MetricGrid from '../../components/MetricGrid.astro';
import RepoLinks from '../../components/RepoLinks.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { assertProjectAssets } from '../../lib/content-guards';
import { CONTACT_SUBJECTS, mailto } from '../../lib/contact';
import { getProjects } from '../../lib/projects';
import { linkableRepos } from '../../lib/repos';

export async function getStaticPaths() {
  const projects = await getProjects();

  assertProjectAssets(projects);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const shortTitle = data.shortTitle ?? data.title;
const gallery = data.gallery;
const shownStack = data.stack.slice(0, 4);
const publishedRepos = linkableRepos(data.repos);

const allProjects = await getProjects();
const position = allProjects.findIndex((entry) => entry.id === project.id);
const previous = position > 0 ? allProjects[position - 1] : undefined;
const next = position >= 0 && position < allProjects.length - 1 ? allProjects[position + 1] : undefined;
---

<BaseLayout title={data.title} description={data.summary} image={data.cover.src}>
  <article>
    <header class="shell pt-8 md:pt-10">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-muted">
        <a class="transition hover:text-paper" href="/projects">Projects</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="text-paper/70">{shortTitle}</span>
      </nav>

      <div class="mt-8 grid gap-6 lg:grid-cols-[1.45fr_0.55fr] lg:items-end lg:gap-12">
        <div>
          <p class="eyebrow">Project {String(data.order).padStart(2, '0')}</p>
          <h1 class="h-project rise mt-4 max-w-3xl">{data.title}</h1>
        </div>
        <p class="max-w-xl text-sm leading-relaxed text-muted md:text-base">{data.summary}</p>
      </div>

      <ul class="mt-7 flex flex-wrap gap-1.5">
        <li class="chip">{data.timeframe}</li>
        {shownStack.map((tool) => <li class="chip">{tool}</li>)}
        {data.stack.length > shownStack.length && <li class="chip">+{data.stack.length - shownStack.length}</li>}
      </ul>

      <ImageFigure image={data.cover} variant="cover" eager class="mt-8" />
    </header>

    <div class="shell mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-14">
      <div class="flex flex-col gap-12">
        <section aria-labelledby="problem">
          <SectionHeading title="Problem" id="problem" eyebrow="Context" />
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted">{data.problem}</p>
        </section>

        {
          data.research && data.research.length > 0 && (
            <section aria-labelledby="research">
              <SectionHeading title="Research & prior art" id="research" eyebrow="Reading" />
              <ol class="mt-5 flex flex-col gap-3">
                {data.research.map((item, index) => (
                  <li class="card flex gap-4 p-4 md:p-5" data-reveal>
                    <span class="mono pt-0.5 text-[0.66rem] tracking-[0.14em] text-ember">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <div>
                      <p class="text-sm font-medium leading-relaxed text-paper/90">{item.citation}</p>
                      <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted">{item.takeaway}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          data.comparison && data.comparison.length > 0 && (
            <section aria-labelledby="comparison">
              <SectionHeading title="Approaches compared" id="comparison" eyebrow="Trade-offs" />
              <div class="mt-5 grid gap-3 md:grid-cols-2">
                {data.comparison.map((item) => (
                  <article class="card flex flex-col p-4 md:p-5" data-reveal>
                    <h3 class="h-sub">{item.option}</h3>
                    <dl class="mt-4 flex flex-col gap-3 text-sm leading-relaxed">
                      <div>
                        <dt class="label">Strengths</dt>
                        <dd class="mt-1 text-muted">{item.strengths}</dd>
                      </div>
                      <div>
                        <dt class="label">Limits</dt>
                        <dd class="mt-1 text-muted">{item.limits}</dd>
                      </div>
                      <div>
                        <dt class="label">Verdict</dt>
                        <dd class="mt-1 text-paper/90">{item.verdict}</dd>
                      </div>
                    </dl>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        <section aria-labelledby="approach">
          <SectionHeading title="Approach" id="approach" eyebrow="Method" />
          <ol class="mt-5 flex flex-col gap-3">
            {
              data.approach.map((step, index) => (
                <li class="card flex gap-4 p-4 md:p-5" data-reveal>
                  <span class="mono pt-0.5 text-[0.66rem] tracking-[0.14em] text-ember">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <p class="max-w-2xl text-sm leading-relaxed text-muted">{step}</p>
                </li>
              ))
            }
          </ol>
        </section>

        {
          data.contribution && data.contribution.length > 0 && (
            <section aria-labelledby="contribution">
              <SectionHeading title="What I personally built" id="contribution" eyebrow="Contribution" />
              <div class="card mt-5 border-l-2 border-l-ember/70 p-5 md:p-6">
                <ul class="flex flex-col gap-2.5">
                  {data.contribution.map((item) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-muted">
                      <span class="mt-[0.45rem] h-1 w-1 shrink-0 rounded-full bg-ember" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )
        }

        <section aria-labelledby="results">
          <SectionHeading title="Results" id="results" eyebrow="Evidence" />
          <MetricGrid metrics={data.results} class="mt-5" />
          <div class="mt-8 flex flex-col gap-6">
            {gallery.map((image) => <ImageFigure image={image} />)}
          </div>
        </section>

        <section aria-labelledby="reflection">
          <SectionHeading title="What I would do differently" id="reflection" eyebrow="Reflection" />
          <div class="card mt-5 border-l-2 border-l-blood/70 p-5 md:p-6">
            <p class="serif max-w-2xl text-[clamp(1.15rem,2vw,1.45rem)] leading-[1.4] text-paper/90">
              {data.reflection}
            </p>
          </div>
        </section>
      </div>

      <aside class="h-fit lg:sticky lg:top-24">
        <div class="card p-5">
          <p class="label">Ownership</p>
          <p class="mt-2 text-sm leading-relaxed text-paper/90">{data.ownership}</p>

          <div class="mt-5 border-t border-line/80 pt-4">
            <p class="label">Timeframe</p>
            <p class="mt-1.5 text-sm">{data.timeframe}</p>
          </div>

          <div class="mt-5 border-t border-line/80 pt-4">
            <p class="label">Stack</p>
            <ul class="mt-2.5 flex flex-wrap gap-1.5">
              {data.stack.map((tool) => <li class="tag">{tool}</li>)}
            </ul>
          </div>

          {
            publishedRepos.length > 0 && (
              <div class="mt-5 border-t border-line/80 pt-4">
                <p class="label">Repository</p>
                <div class="mt-2.5">
                  <RepoLinks repos={data.repos} />
                </div>
              </div>
            )
          }
        </div>
      </aside>
    </div>

    <nav aria-label="Project navigation" class="shell mt-16">
      <div class="grid gap-3 sm:grid-cols-2">
        {
          previous ? (
            <a
              href={`/projects/${previous.id}`}
              class="card card-hover group flex flex-col justify-between gap-6 p-5"
            >
              <span class="label flex items-center gap-2">
                <span class="transition group-hover:-translate-x-1 group-hover:text-ember" aria-hidden="true">←</span>
                Previous
              </span>
              <span class="h-sub">{previous.data.shortTitle ?? previous.data.title}</span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )
        }
        {
          next ? (
            <a
              href={`/projects/${next.id}`}
              class="card card-hover group flex flex-col justify-between gap-6 p-5 sm:items-end sm:text-right"
            >
              <span class="label flex items-center gap-2">
                Next
                <span class="transition group-hover:translate-x-1 group-hover:text-ember" aria-hidden="true">→</span>
              </span>
              <span class="h-sub">{next.data.shortTitle ?? next.data.title}</span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )
        }
      </div>

      <div class="card mt-3 flex flex-wrap items-center justify-between gap-4 p-5 md:p-6">
        <a
          class="group inline-flex items-center gap-2 text-sm font-medium text-muted transition hover:text-paper"
          href="/projects"
        >
          <span class="transition group-hover:-translate-x-1" aria-hidden="true">←</span>
          All projects
        </a>
        <a
          class="btn btn-solid"
          href={mailto(
            CONTACT_SUBJECTS.project(shortTitle),
            `Hi Mohammed,\n\nI'd like to ask about ${data.title}.\n\n`
          )}
        >
          Ask me about this project
        </a>
      </div>
    </nav>
  </article>
</BaseLayout>
