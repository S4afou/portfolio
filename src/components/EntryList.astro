---
interface Entry {
  period: string;
  title: string;
  org?: string;
  issuer?: string;
  detail?: string;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<ol class="mt-5 flex flex-col gap-2">
  {
    entries.map((entry) => (
      <li class="card grid gap-2 p-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-6 md:p-5">
        <span class="label pt-0.5">{entry.period}</span>
        <div>
          <h3 class="text-sm font-semibold leading-snug tracking-[-0.01em]">{entry.title}</h3>
          <p class="mt-1 text-sm text-ember">{entry.org ?? entry.issuer}</p>
          {entry.detail && <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-muted">{entry.detail}</p>}
        </div>
      </li>
    ))
  }
</ol>
