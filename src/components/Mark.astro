---
interface Props {
  size?: number;
  class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  class={className}
  role="img"
  aria-label="Original umbrella mark"
>
  <path d="M32 2.5 58 17v30L32 61.5 6 47V17Z" stroke="currentColor" stroke-width="1.25"></path>
  <g transform="translate(32 29)">
    <path
      d="M-17 1a17 17 0 0 1 34 0A5.67 5.67 0 0 1 5.67 1A5.67 5.67 0 0 1 -5.67 1A5.67 5.67 0 0 1 -17 1Z"
      fill="currentColor"></path>
    <path d="M0 -15V1" stroke="#c8102e" stroke-width="1.1"></path>
    <path
      d="M0 -15 -17 1M0 -15 17 1M0 -15 5.67 1M0 -15 -5.67 1"
      stroke="#c8102e"
      stroke-width="0.9"
      opacity="0.95"></path>
    <path d="M0 1v16a2.6 2.6 0 0 0 5.2 0" stroke="#c8102e" stroke-width="2" stroke-linecap="round"></path>
  </g>
</svg>
