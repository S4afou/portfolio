---
import { NAV, SITE } from '../lib/site';
import Mark from './Mark.astro';
---

<header class="sticky top-0 z-50 border-b border-line bg-void/85 backdrop-blur-md">
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label={`${SITE.name} — home`}>
      <Mark size={26} class="shrink-0 text-paper" />
      <span class="hidden truncate font-mono text-[11px] uppercase tracking-[0.18em] text-paper/90 md:inline">
        {SITE.name}
      </span>
    </a>

    <nav aria-label="Primary" class="flex shrink-0 items-center gap-3 md:gap-5">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="link-underline font-mono text-[11px] uppercase tracking-[0.16em] text-paper/85 hover:text-paper"
          >
            {item.label}
          </a>
        ))
      }
      <a href={SITE.cv} download class="btn btn-solid !px-3 !py-2 text-[10px]">CV</a>
    </nav>
  </div>
</header>
