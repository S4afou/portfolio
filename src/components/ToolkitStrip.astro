---
import { LANGUAGES } from '../lib/site';
import { SKILL_GROUPS } from '../lib/skills';
import SectionHeading from './SectionHeading.astro';
---

<section aria-labelledby="toolkit" class="shell mt-24">
  <SectionHeading title="Skills & languages" id="toolkit" />

  <dl class="mt-8 grid gap-x-12 gap-y-8 sm:grid-cols-2">
    {
      SKILL_GROUPS.map((group) => (
        <div class="border-t border-line pt-4">
          <dt class="label">{group.label}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-paper/90">{group.items.join(' · ')}</dd>
        </div>
      ))
    }
    <div class="border-t border-line pt-4">
      <dt class="label">Languages</dt>
      <dd class="mt-2 text-sm leading-relaxed text-paper/90">{LANGUAGES.join(' · ')}</dd>
    </div>
  </dl>
</section>
