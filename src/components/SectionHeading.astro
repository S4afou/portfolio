---
interface Props {
  index: string;
  title: string;
  id: string;
}

const { index, title, id } = Astro.props;
---

<div class="flex items-baseline gap-4 border-t border-line pt-5">
  <span class="mono text-xs tracking-[0.2em] text-ember">{index}</span>
  <h2 id={id} class="h-section">{title}</h2>
</div>
