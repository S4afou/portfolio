---
interface Props {
  title: string;
  id: string;
  eyebrow?: string;
  actionHref?: string;
  actionLabel?: string;
  note?: string;
}

const { title, id, eyebrow, actionHref, actionLabel, note } = Astro.props;
---

<div class="border-t border-line/80 pt-6" data-reveal>
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={id} class:list={['h-section', eyebrow && 'mt-3']}>{title}</h2>
    </div>
    {
      actionHref && actionLabel && (
        <a
          class="group inline-flex items-center gap-2 text-xs font-semibold tracking-wide text-muted transition hover:text-paper"
          href={actionHref}
        >
          {actionLabel}
          <span class="transition group-hover:translate-x-1 group-hover:text-ember" aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
  {note && <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{note}</p>}
</div>
