---
import { LANGUAGES } from '../lib/site';
import { SKILL_GROUPS } from '../lib/skills';
import SectionHeading from './SectionHeading.astro';
---

<section aria-labelledby="toolkit" class="shell mt-16">
  <SectionHeading
    id="toolkit"
    eyebrow="Technical toolkit"
    title="Skills & languages"
    note="The tools I reach for across machine learning, data work, systems, and software delivery."
  />

  <dl class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      SKILL_GROUPS.map((group) => (
        <div class="card card-hover p-5" data-reveal>
          <dt class="label">{group.label}</dt>
          <dd class="mt-3 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </dd>
        </div>
      ))
    }
    <div class="card card-hover p-5" data-reveal>
      <dt class="label">Languages</dt>
      <dd class="mt-3 flex flex-wrap gap-1.5">
        {LANGUAGES.map((language) => <span class="tag">{language}</span>)}
      </dd>
    </div>
  </dl>
</section>
