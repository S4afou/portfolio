---
interface Props {
  title: string;
  id: string;
  actionHref?: string;
  actionLabel?: string;
  note?: string;
}

const { title, id, actionHref, actionLabel, note } = Astro.props;
---

<div class="border-t border-line pt-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
    <h2 id={id} class="h-section">{title}</h2>
    {
      actionHref && actionLabel && (
        <a class="text-sm font-medium text-muted transition hover:text-paper" href={actionHref}>
          {actionLabel} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
  {note && <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">{note}</p>}
</div>
