---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <section class="shell flex min-h-[60vh] flex-col justify-center py-20">
    <p class="label text-ember">Error 404</p>
    <h1 class="h-display mt-5">Not found</h1>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">
      The umbrella does not extend this far. The page you asked for is not here — but the projects are.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-solid" href="/">Back home</a>
      <a class="btn btn-ghost" href="/projects">Browse projects</a>
    </div>
  </section>
</BaseLayout>
