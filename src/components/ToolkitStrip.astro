---
import { SKILL_GROUPS } from '../lib/skills';
import SectionHeading from './SectionHeading.astro';
---

<section aria-labelledby="toolkit" class="shell mt-24">
  <SectionHeading index="STACK" title="Toolkit" id="toolkit" />

  <dl class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {
      SKILL_GROUPS.map((group) => (
        <div class="bg-void p-5">
          <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted">{group.label}</dt>
          <dd class="mt-3 text-sm leading-relaxed text-paper/90">{group.items.join(' · ')}</dd>
        </div>
      ))
    }
  </dl>
</section>
