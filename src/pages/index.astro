---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ToolkitStrip from '../components/ToolkitStrip.astro';
import { EXPERIENCE } from '../lib/background';
import { LANGUAGES, SITE } from '../lib/site';

const allProjects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = allProjects.filter((project) => project.data.featured);

const dossier = [
  { label: 'Based in', value: SITE.location, marker: false },
  { label: 'Status', value: SITE.availability, marker: true },
  { label: 'Focus', value: 'Computer vision · Speech · MLOps', marker: false },
  { label: 'Languages', value: LANGUAGES.join(' · '), marker: false },
];
---

<BaseLayout>
  <section class="shell pt-14 md:pt-24">
    <div class="grid items-start gap-12 lg:grid-cols-[1.55fr_1fr]">
      <div class="rise">
        <p class="label flex items-center gap-2.5">
          <span class="h-1.5 w-1.5 shrink-0 bg-blood" aria-hidden="true"></span>
          AI &amp; Data Science engineering student · {SITE.school}
        </p>
        <h1 class="h-display mt-6">Medjahri<br />Mohammed<br />Safouane</h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted md:text-xl">
          I build end-to-end machine-learning systems:
          <span class="serif text-paper">the dataset, the model, and the pipeline that keeps it honest.</span>
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a class="btn btn-solid" href={`mailto:${SITE.email}`}>Email me</a>
          <a class="btn-text" href={SITE.cv} download>Download CV <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <aside class="lg:pt-1">
        <p class="label">Dossier</p>
        <dl class="mt-3">
          {
            dossier.map((row, index) => (
              <div
                class:list={[
                  'grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 border-t border-line py-4',
                  index === dossier.length - 1 && 'border-b',
                ]}
              >
                <dt class="label">{row.label}</dt>
                <dd class={row.marker ? 'flex items-start gap-2 text-sm' : 'text-sm'}>
                  {row.marker && <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-blood" aria-hidden="true" />}
                  <span>{row.value}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </section>

  <section aria-labelledby="projects" class="shell mt-24">
    <SectionHeading title="Projects" id="projects" />

    <div class="mt-8 grid gap-x-6 gap-y-12 md:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>

    <div class="mt-12 border-t border-line pt-5">
      <a
        class="group inline-flex items-baseline gap-3 text-base font-medium transition hover:text-paper"
        href="/projects"
      >
        Show all {allProjects.length} projects
        <span class="text-muted transition group-hover:translate-x-1 group-hover:text-blood" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section aria-labelledby="experience" class="shell mt-24">
    <SectionHeading title="Experience" id="experience" actionHref="/about" actionLabel="About" />

    <ol class="mt-8 grid gap-x-12 md:grid-cols-2">
      {
        EXPERIENCE.map((entry) => (
          <li class="border-t border-line py-5">
            <p class="label">{entry.period}</p>
            <h3 class="mt-2 text-base font-semibold leading-snug">{entry.title}</h3>
            <p class="mt-1 text-sm text-ember">{entry.org}</p>
            <p class="mt-2 max-w-prose text-sm leading-relaxed text-muted">{entry.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <ToolkitStrip />

  <ContactBlock />
</BaseLayout>
