---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import MoreWork from '../components/MoreWork.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import ToolkitStrip from '../components/ToolkitStrip.astro';
import { recentAchievements } from '../lib/achievements';
import { SITE } from '../lib/site';

const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order
);
const recent = recentAchievements(5);
---

<BaseLayout>
  <section class="shell pt-14 md:pt-20">
    <div class="grid items-start gap-12 lg:grid-cols-[1.55fr_1fr]">
      <div class="rise">
        <p class="eyebrow">AI &amp; Data Science engineering student · {SITE.school}</p>
        <h1 class="h-display mt-5">Medjahri<br />Mohammed<br />Safouane</h1>
        <p class="mt-7 max-w-xl text-base leading-relaxed text-muted md:text-lg">
          I build end-to-end machine-learning systems — the dataset, the model, and the pipeline that
          keeps it honest once it is deployed.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-solid" href={`mailto:${SITE.email}`}>Email me</a>
          <a class="btn btn-ghost" href={SITE.cv} download>Download CV</a>
        </div>
      </div>

      <aside class="border border-line bg-panel/50 p-7 md:p-9">
        <p class="eyebrow">At a glance</p>
        <dl class="mt-5 flex flex-col gap-5">
          <div>
            <dt class="eyebrow">Based in</dt>
            <dd class="mt-1 text-sm">{SITE.location}</dd>
          </div>
          <div>
            <dt class="eyebrow">Status</dt>
            <dd class="mt-1 flex items-start gap-2 text-sm">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-blood" aria-hidden="true"></span>
              <span>{SITE.availability}</span>
            </dd>
          </div>
          <div>
            <dt class="eyebrow">Focus</dt>
            <dd class="mt-1 text-sm">Computer vision · Speech · MLOps</dd>
          </div>
          <div>
            <dt class="eyebrow">Languages</dt>
            <dd class="mt-1 text-sm">English · French · Arabic</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section aria-labelledby="selected-projects" class="shell mt-20">
    <SectionHeading
      index="01"
      title="Selected Projects"
      id="selected-projects"
      actionHref="/projects"
      actionLabel="All projects"
    />

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <MoreWork />
  <ToolkitStrip />

  <section aria-labelledby="track-record" class="shell mt-24">
    <SectionHeading
      index="02"
      title="Track record"
      id="track-record"
      actionHref="/about"
      actionLabel="Full history"
    />
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
      An internship, a teaching role, two student-club offices, and the baccalaureate that started it.
    </p>
    <div class="mt-8">
      <Timeline items={recent} />
    </div>
  </section>

  <ContactBlock />
</BaseLayout>
