---
interface Entry {
  period?: string;
  title: string;
  org?: string;
  issuer?: string;
  detail?: string;
  url?: string;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<ol class="mt-5 flex flex-col gap-2">
  {
    entries.map((entry) => (
      <li
        class:list={[
          'card grid gap-2 p-4 md:p-5',
          entry.period ? 'sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-6' : '',
        ]}
      >
        {entry.period && <span class="label pt-0.5">{entry.period}</span>}
        <div>
          <h3 class="text-sm font-semibold leading-snug tracking-[-0.01em]">
            {entry.url ? (
              <a
                href={entry.url}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-baseline gap-1.5 transition-colors hover:text-ember"
              >
                {entry.title}
                <span aria-hidden="true" class="text-xs text-muted">
                  ↗
                </span>
              </a>
            ) : (
              entry.title
            )}
          </h3>
          <p class="mt-1 text-sm text-ember">{entry.org ?? entry.issuer}</p>
          {entry.detail && <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-muted">{entry.detail}</p>}
        </div>
      </li>
    ))
  }
</ol>
