---
import type { Metric } from '../lib/project-schema';

interface Props {
  metrics: Metric[];
  class?: string;
}

const { metrics, class: className = '' } = Astro.props;
---

<ul class:list={['grid gap-6 sm:grid-cols-3', className]}>
  {
    metrics.map((metric) => (
      <li class="border-t border-line pt-4">
        <p class="mono text-[clamp(1.7rem,4vw,2.5rem)] leading-none tracking-[-0.04em]">{metric.value}</p>
        <p class="mt-3 text-sm font-medium">{metric.name}</p>
        <p class="mt-1 text-xs leading-relaxed text-muted">{metric.context}</p>
      </li>
    ))
  }
</ul>
