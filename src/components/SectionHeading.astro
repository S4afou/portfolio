---
interface Props {
  index: string;
  title: string;
  id: string;
  actionHref?: string;
  actionLabel?: string;
}

const { index, title, id, actionHref, actionLabel } = Astro.props;
---

<div class="flex flex-wrap items-baseline justify-between gap-4 border-t border-line pt-5">
  <div class="flex items-baseline gap-4">
    <span class="mono text-xs tracking-[0.2em] text-ember">{index}</span>
    <h2 id={id} class="h-section">{title}</h2>
  </div>
  {
    actionHref && actionLabel && (
      <a
        class="mono text-[11px] uppercase tracking-[0.16em] text-muted hover:text-paper"
        href={actionHref}
      >
        {actionLabel} →
      </a>
    )
  }
</div>
