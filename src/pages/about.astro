---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ToolkitStrip from '../components/ToolkitStrip.astro';
import { CERTIFICATIONS, EDUCATION, EXPERIENCE, LEADERSHIP } from '../lib/background';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="About"
  description="Medjahri Mohammed Safouane — AI & Data Science engineering student at ESI-SBA. Education, experience, leadership, skills, and languages."
>
  <section class="shell pt-14 md:pt-24">
    <p class="label">Profile</p>
    <h1 class="h-display mt-5">About</h1>
    <p class="serif mt-6 max-w-2xl text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.15] text-paper">
      I care about what happens after the demo.
    </p>

    <div class="mt-10 grid items-start gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div class="flex max-w-2xl flex-col gap-5 text-base leading-relaxed text-muted">
        <p>
          I am an AI &amp; Data Science engineering student at ESI-SBA in Sidi Bel Abbès. I came in
          through the mathematics preparatory cycle, and most of what I enjoy sits where a model meets
          a messy reality: a phone photograph instead of a flatbed scanner, a speech model on a laptop
          CPU, a detector that notices its own drift.
        </p>
        <p>
          My Projects tend to start with data collection and end with something that can be run. I
          care about evaluation more than demo screenshots, which is why every Project here names the
          metric, the setting it was measured in, and what I would do differently. Some of that means
          reporting worse numbers than a CV bullet would: the figures on this site are the measured
          ones.
        </p>
        <p>
          I am looking for a PFE or research internship where I can own an applied machine-learning
          problem end to end — particularly computer vision, speech, and the monitoring work that
          keeps a deployed model honest. I work in Python, mostly with PyTorch and scikit-learn, and I
          am comfortable with the parts nobody puts in a demo: labels, pipelines, and the number
          everyone would rather not report.
        </p>
      </div>

      <aside class="h-fit lg:border-l lg:border-line lg:pl-8">
        <p class="label">Open to</p>
        <p class="mt-2 text-sm">{SITE.availability}.</p>
        <p class="mt-5 label">Based in</p>
        <p class="mt-1 text-sm">{SITE.location}</p>
        <div class="mt-6 flex flex-col items-start gap-4">
          <a class="btn btn-solid" href={SITE.cv} download>Download CV</a>
          <a class="btn-text" href={`mailto:${SITE.email}`}>Email me <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section aria-labelledby="education" class="shell mt-20">
    <SectionHeading title="Education" id="education" />

    <EntryList entries={EDUCATION} />
  </section>

  <section aria-labelledby="experience" class="shell mt-16">
    <SectionHeading title="Experience" id="experience" />

    <EntryList entries={EXPERIENCE} />
  </section>

  <section aria-labelledby="leadership" class="shell mt-16">
    <SectionHeading
      title="Leadership & extracurricular"
      id="leadership"
      note="Student-club offices, kept separate from professional Experience."
    />

    <EntryList entries={LEADERSHIP} />
  </section>

  {
    CERTIFICATIONS.length > 0 && (
      <section aria-labelledby="certifications" class="shell mt-16">
        <SectionHeading title="Certifications & awards" id="certifications" />
        <EntryList entries={CERTIFICATIONS} />
      </section>
    )
  }

  <ToolkitStrip />
</BaseLayout>
