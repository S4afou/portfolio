---
import type { Metric } from '../lib/project-schema';

interface Props {
  metrics: Metric[];
  class?: string;
}

const { metrics, class: className = '' } = Astro.props;
---

<ul class:list={['grid gap-3 sm:grid-cols-3', className]}>
  {
    metrics.map((metric) => (
      <li class="card card-hover p-4 md:p-5" data-reveal>
        <span class="block h-0.5 w-6 bg-blood" aria-hidden="true" />
        <p class="mono mt-4 text-[clamp(1.6rem,3vw,2.2rem)] leading-none tracking-[-0.05em]">{metric.value}</p>
        <p class="mt-3 text-sm font-semibold">{metric.name}</p>
        <p class="mt-1 text-xs leading-relaxed text-muted">{metric.context}</p>
      </li>
    ))
  }
</ul>
