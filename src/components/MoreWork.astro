---
import { MORE_WORK } from '../lib/more-work';
---

<section aria-labelledby="more-work" class="shell mt-24">
  <div class="flex items-baseline gap-4 border-t border-line pt-5">
    <span class="mono text-xs tracking-[0.2em] text-ember">MORE</span>
    <h2 id="more-work" class="h-section">More work</h2>
  </div>
  <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
    Two shorter experiments, kept short on purpose. The four Projects above are the ones worth your time.
  </p>

  <ul class="mt-8 grid gap-px border border-line bg-line md:grid-cols-2">
    {
      MORE_WORK.map((entry) => (
        <li class="bg-void p-6">
          <h3 class="h-sub">{entry.title}</h3>
          <p class="mt-2 max-w-prose text-sm leading-relaxed text-muted">{entry.description}</p>
          <ul class="mt-5 flex flex-wrap gap-1.5">
            {entry.stack.map((tool) => (
              <li class="tag">{tool}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
